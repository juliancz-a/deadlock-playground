---
import Icon from './Icon.astro';
import changelogData from '../data/changelog.json';

const changelogEntries = changelogData.history;

// Format JSON display so that long string properties like "markdown" break into multiple lines cleanly
function formatJsonDisplay(data: any): string {
  const jsonStr = JSON.stringify(data, null, 2);
  return jsonStr.replace(/"markdown":\s*"([\s\S]*?)",\n/g, (match, p1) => {
    const lines = p1.split('\\n');
    return lines
      .map((line: string, idx: number) => {
        if (idx === 0) return `  "markdown": "${line}\\n"`;
        const isLast = idx === lines.length - 1;
        return `    + "${line}${isLast ? '",\n' : '\\n"'}`;
      })
      .join('\n');
  });
}

const displayJson = formatJsonDisplay(changelogData);
---

<div class="changelog-container">
  <div class="changelog-split">
    <!-- Left: Timeline feed -->
    <div class="timeline-column">
      <div class="column-header">
        <div class="header-titles">
          <span class="badge badge-gold">Application News</span>
          <h2 class="font-heading">Changelog & Release Notes</h2>
        </div>
        <a 
          href="/api/changelog.json" 
          target="_blank" 
          class="btn-secondary"
          title="Open raw JSON API endpoint"
        >
          <Icon name="code" size={16} />
          <span>Raw API JSON</span>
        </a>
      </div>

      <div class="timeline-feed">
        {changelogEntries.map((entry) => (
          <article class="timeline-card card-panel">
            <div class="timeline-header">
              <div class="version-meta">
                <span class={`badge badge-${entry.badgeType || 'sage'}`}>{entry.badge || 'Release'}</span>
                <span class="version-number font-code">{entry.version}</span>
                <span class="version-date">{entry.date}</span>
              </div>

              {entry.videoUrl && (
                <a 
                  href={entry.videoUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="btn-video-showcase"
                  title="Watch Video Showcase for this release"
                >
                  <Icon name="brand-youtube" size={15} color="#e50914" />
                  <span>Watch Video Showcase</span>
                  <Icon name="external-link" size={12} />
                </a>
              )}
            </div>

            <h3 class="entry-title font-heading">{entry.title}</h3>

            <ul class="entry-list">
              {entry.highlights.map((item) => (
                <li class="entry-item">
                  <Icon name="circle-check" size={16} color="var(--dl-accent-sage)" class="item-icon" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>

    <!-- Right: Live API Inspector for Godot Integration -->
    <div class="api-column">
      <div class="api-card card-panel">
        <div class="api-header">
          <div class="api-badge-row">
            <span class="badge badge-sage">HTTP REST Endpoint</span>
            <span class="badge badge-orange">CORS Enabled</span>
          </div>
          <h3 class="font-heading">Desktop App Integration</h3>
          <p class="api-desc">
            The Godot C# application consumes this endpoint on startup to dynamically synchronize <span class="font-code">ChangelogModalUI.cs</span> and illuminate the news notification badge.
          </p>
        </div>

        <div class="endpoint-box">
          <span class="method">GET</span>
          <span class="url font-code">/api/changelog.json</span>
          <button id="copyApiUrlBtn" class="copy-btn" title="Copy full URL">
            <Icon name="copy" size={15} />
          </button>
        </div>

        <div class="code-preview-frame">
          <div class="code-header">
            <span>JSON Response Preview</span>
            <button id="fetchLiveBtn" class="btn-fetch">
              <Icon name="refresh" size={13} />
              <span>Test Live Fetch</span>
            </button>
          </div>
          <pre id="jsonPreviewBox" class="code-block font-code"><code>{displayJson}</code></pre>
        </div>

        <div class="api-footer">
          <div class="api-stat">
            <span class="stat-label">Cache Strategy:</span>
            <span class="stat-val">user://cache/changelog_cache.json</span>
          </div>
          <div class="api-stat">
            <span class="stat-label">Latest Version:</span>
            <span class="stat-val">v{changelogData.latestVersion}</span>
          </div>
          <div class="api-stat">
            <span class="stat-label">Data File:</span>
            <span class="stat-val">web/src/data/changelog.json</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .changelog-container {
    width: 100%;
    height: 100%;
    overflow-y: auto;
    padding: 20px;
  }

  .changelog-split {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 20px;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .timeline-column {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .column-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header-titles h2 {
    font-size: 1.45rem;
    color: var(--dl-accent-brass);
    margin-top: 4px;
  }

  .timeline-feed {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .timeline-card {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .timeline-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
  }

  .version-meta {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .version-number {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--dl-accent-gold);
  }

  .version-date {
    font-size: 0.775rem;
    color: var(--dl-text-dim);
  }

  .btn-video-showcase {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(229, 9, 20, 0.12);
    border: 1px solid rgba(229, 9, 20, 0.35);
    color: #fca5a5;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .btn-video-showcase:hover {
    background: #e50914;
    color: #ffffff;
    border-color: #e50914;
    transform: translateY(-1px);
  }

  .entry-title {
    font-size: 1.15rem;
    color: var(--dl-accent-brass);
    line-height: 1.3;
  }

  .entry-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .entry-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.85rem;
    color: var(--dl-text-secondary);
    line-height: 1.45;
  }

  .item-icon {
    margin-top: 2px;
    flex-shrink: 0;
  }

  /* Right API Column */
  .api-column {
    display: flex;
    flex-direction: column;
    min-width: 0;
    max-width: 100%;
  }

  .api-card {
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
  }

  .api-badge-row {
    display: flex;
    gap: 8px;
    margin-bottom: 6px;
  }

  .api-card h3 {
    font-size: 1.25rem;
    color: var(--dl-accent-brass);
  }

  .api-desc {
    font-size: 0.825rem;
    color: var(--dl-text-muted);
    line-height: 1.45;
  }

  .endpoint-box {
    display: flex;
    align-items: center;
    background: var(--dl-bg-main);
    border: 1px solid var(--dl-border);
    border-radius: 6px;
    padding: 8px 12px;
    gap: 10px;
    min-width: 0;
  }

  .method {
    font-size: 0.75rem;
    font-weight: 800;
    padding: 2px 6px;
    background: rgba(114, 148, 127, 0.25);
    color: var(--dl-accent-sage);
    border-radius: 4px;
    flex-shrink: 0;
  }

  .url {
    font-size: 0.825rem;
    color: var(--dl-text-primary);
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .copy-btn {
    background: transparent;
    border: none;
    color: var(--dl-text-muted);
    padding: 4px;
    border-radius: 4px;
    flex-shrink: 0;
  }
  .copy-btn:hover {
    color: var(--dl-accent-brass);
    background: var(--dl-bg-card);
  }

  .code-preview-frame {
    background: var(--dl-bg-main);
    border: 1px solid var(--dl-border);
    border-radius: 6px;
    overflow: hidden;
    min-width: 0;
    max-width: 100%;
  }

  .code-header {
    background: #0f1513;
    padding: 8px 12px;
    border-bottom: 1px solid var(--dl-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--dl-text-dim);
  }

  .btn-fetch {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: transparent;
    border: none;
    color: var(--dl-accent-sage);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .btn-fetch:hover {
    color: var(--dl-accent-gold);
  }

  .code-block {
    padding: 14px;
    font-size: 0.75rem;
    color: #93c5fd;
    line-height: 1.45;
    max-height: 250px;
    overflow: auto;
    white-space: pre-wrap;
    word-break: break-word;
    overflow-wrap: anywhere;
    max-width: 100%;
    min-width: 0;
  }

  .api-footer {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 10px;
    border-top: 1px solid rgba(43, 63, 55, 0.4);
    font-size: 0.75rem;
  }

  .api-stat {
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }
  .stat-label {
    color: var(--dl-text-dim);
    flex-shrink: 0;
  }
  .stat-val {
    color: var(--dl-accent-brass);
    font-family: var(--dl-font-code);
    text-align: right;
    word-break: break-all;
  }

  @media (max-width: 900px) {
    .changelog-split {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .changelog-container {
      padding: 12px;
    }
    .timeline-card, .api-card {
      padding: 14px;
    }
    .version-meta {
      flex-wrap: wrap;
      gap: 6px;
    }
    .code-block {
      padding: 10px;
      font-size: 0.7rem;
    }
  }
</style>

<script>
  // Copy API URL
  const copyBtn = document.getElementById('copyApiUrlBtn');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      const fullUrl = `${window.location.origin}/api/changelog.json`;
      navigator.clipboard.writeText(fullUrl).then(() => {
        copyBtn.innerHTML = '✓';
        setTimeout(() => {
          copyBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>`;
        }, 1500);
      });
    });
  }

  // Live Fetch test with multi-line formatted output
  const fetchBtn = document.getElementById('fetchLiveBtn');
  const previewBox = document.getElementById('jsonPreviewBox');
  if (fetchBtn && previewBox) {
    fetchBtn.addEventListener('click', async () => {
      fetchBtn.innerHTML = 'Fetching...';
      try {
        const res = await fetch('/api/changelog.json');
        const json = await res.json();
        const jsonStr = JSON.stringify(json, null, 2);
        const formatted = jsonStr.replace(/"markdown":\s*"([\s\S]*?)",\n/g, (match, p1) => {
          const lines = p1.split('\\n');
          return lines.map((l, i) => i === 0 ? `  "markdown": "${l}\\n"` : `    + "${l}${i === lines.length - 1 ? '",\n' : '\\n"'}`).join('\n');
        });
        previewBox.innerHTML = `<code>${formatted}</code>`;
        fetchBtn.innerHTML = '✓ Live Response';
      } catch (e) {
        fetchBtn.innerHTML = 'Failed';
      }
      setTimeout(() => {
        fetchBtn.innerHTML = `<span>Test Live Fetch</span>`;
      }, 2000);
    });
  }
</script>
