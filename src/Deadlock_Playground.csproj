<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ValveResourceFormat" Version="21.1.7798" />
    <PackageReference Include="ValvePak" Version="7.2.0.221" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="ValveKeyValue" Version="0.80.0.542" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="ValveResourceFormatRendererFolder\**" />
    <Compile Remove="tools\inspector\**" />
  </ItemGroup>
</Project>