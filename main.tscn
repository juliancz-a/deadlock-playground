[node name="RichTextLabel" type="RichTextLabel" parent="UIRoot/MainHUD/ModalsLayer/AboutModal/MarginContainer/VBoxContainer/ContentCard/Margin/ScrollContainer" unique_id=1988160098]
layout_mode = 2
